# Copy this file to .env.local and set a browser-restricted Google Maps key.
# Vite exposes VITE_* values to the browser; never use an unrestricted key here.
VITE_GOOGLE_MAPS_API_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Production: route these paths to the bundled Python OSM service.
# The service also serves osm-vendor/, tiles.json and tiles/.
# VITE_OSM_ASSET_BASE_URL=/local-map
# VITE_OSM_SERVICE_URL=/local-map
# Local development uses Travel/osm automatically; no OSM variables required.
 