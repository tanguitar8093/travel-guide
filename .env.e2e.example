# Copy to .env.e2e.local (ignored by Git). Use two dedicated workspace members.
# A needs admin access for the /data mode switch; B needs another saved place.
# App connection settings remain in .env.local; never use a service-role key.
# This test creates real data in the configured Supabase project.
E2E_ALLOW_LIVE_WRITES=false
E2E_A_EMAIL=
E2E_A_PASSWORD=
E2E_B_EMAIL=
E2E_B_PASSWORD=
