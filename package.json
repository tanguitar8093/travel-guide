{
  "name": "travel-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:poc:public-itinerary": "vitest run --config vitest.public-itinerary-poc.config.ts",
    "dev:poc:public-itinerary": "vite --config poc/public-itinerary-sharing/vite.config.ts",
    "build:poc:public-itinerary": "npm run typecheck:poc:public-itinerary && vite build --config poc/public-itinerary-sharing/vite.config.ts",
    "test:poc:public-itinerary:db": "vitest run --config vitest.public-itinerary-poc.config.ts poc/public-itinerary-sharing/database.test.ts",
    "typecheck:poc:public-itinerary": "tsc -p poc/public-itinerary-sharing/tsconfig.json",
    "e2e:install": "playwright install chromium",
    "e2e:install:linux": "playwright install --with-deps chromium",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test e2e/core-check.e2e.ts",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "core-check": "node scripts/core-check.mjs",
    "core-check:app": "node scripts/core-check-app.mjs",
    "core-check:supabase": "node scripts/core-check-supabase.mjs",
    "core-check:google": "node scripts/core-check-google.mjs",
    "core-check:psql": "node scripts/core-check-psql.mjs",
    "preview": "vite preview",
    "osm:start": "python3 osm/server.py",
    "osm:setup": "python3 osm/scripts/download-data.py",
    "osm:build:tiles": "python3 osm/scripts/build-tiles.py",
    "osm:test": "python3 -B -m unittest discover -s osm/scripts -p 'test-*.py'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "ccusage": "^20.0.37",
    "dexie": "^4.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "6.2.6",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
