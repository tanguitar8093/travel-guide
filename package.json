{
  "name": "travel-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e:install": "playwright install chromium",
    "e2e:install:linux": "playwright install --with-deps chromium",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test e2e/core-check.e2e.ts",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "core-check": "node scripts/core-check.mjs",
    "core-check:app": "node scripts/core-check-app.mjs",
    "core-check:supabase": "node scripts/core-check-supabase.mjs",
    "core-check:google": "node scripts/core-check-google.mjs",
    "core-check:psql": "node scripts/core-check-psql.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "ccusage": "^20.0.37",
    "dexie": "^4.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "6.2.6",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
