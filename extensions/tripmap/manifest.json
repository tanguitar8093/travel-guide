{
  "manifest_version": 3,
  "name": "TripMap 快捷加入地點",
  "version": "0.3.2",
  "description": "Google 登入後，從 Google Maps 依名稱與座標快捷加入 TripMap 地點。",
  "permissions": [
    "contextMenus",
    "webNavigation",
    "identity",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.google.com/maps*",
    "https://maps.google.com/*",
    "https://*.google.com.tw/maps*",
    "https://maps.google.com.tw/*",
    "https://*.google.co.jp/maps*",
    "https://maps.google.co.jp/*",
    "https://*.google.co.uk/maps*",
    "https://maps.google.co.uk/*",
    "https://dblpjzimucrlmmgwntiq.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.google.com/maps*",
        "https://maps.google.com/*",
        "https://*.google.com.tw/maps*",
        "https://maps.google.com.tw/*",
        "https://*.google.co.jp/maps*",
        "https://maps.google.co.jp/*",
        "https://*.google.co.uk/maps*",
        "https://maps.google.co.uk/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "120",
  "key": "",
  "action": {
    "default_title": "TripMap 帳號管理",
    "default_popup": "account.html"
  },
  "options_ui": {
    "page": "account.html",
    "open_in_tab": true
  }
}
