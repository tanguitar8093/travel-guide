%% Class-level current architecture; N1-N11 are defined in architecture-notes.md.
flowchart TB
    subgraph ENTRY["Entry / auth / shell - N1,N2"]
        APP["App / routes / usePathname"]
        AUTH["AuthProvider / auth.gateway"]
        GATE["AuthGate / WorkspaceLayout / RouterLink"]
    end
    subgraph FEATURES["Module UI / controller / service"]
        LABEL["LabelModule / LabelController / LabelService - N3"]
        PLACE["PlaceModule / PlaceController / PlaceService - N4"]
        REGION["RegionModule / RegionController / RegionService - N5"]
        ITIN["ItineraryEntry / ItineraryModule / ItineraryController - N6"]
        ISVC["CollaborativeItineraryService / ItineraryService"]
        IMAP["ItineraryMapService / Google Places adapter"]
        DATA["DataManagementModule / controller / service - N7"]
        ROUTE["RouteCalculatorModule / controller / service - N9"]
        ACL["TripCollaborationPanel / controller / service - N10"]
        SHARED["SharedTripService / SharedTripRepository"]
        ACLREPO["TripCollaborationRepository"]
    end
    subgraph STORAGE["Persistence boundary - N8"]
        FACADE["database/index.ts / runtime"]
        LOCAL["Region / Place / Label / Trip / Item / RouteMap / Backup repositories"]
        LDB[("TravelDatabase v7 / standalone")]
        CLOUD["Supabase personal repositories"]
        CLIENT["supabase.client"]
        DB[("Postgres / grants / RLS / scoped RPC")]
    end
    subgraph HYBRID["Account-scoped sync - N11"]
        BACKEND["hybridBackend / LocalSyncStore"]
        HDB[("SyncDatabase v9 / account-project data and outbox")]
        SCHED["hybrid.runtime / HybridStatus"]
        ENGINE["sync-engine / cross-tab Web Lock"]
        ADAPTER["syncCloudAdapter / sharedTripCloud"]
        SLOCAL["SharedTripLocal"]
    end

    APP --> AUTH --> GATE
    AUTH --> BACKEND
    GATE --> LABEL & PLACE & REGION & ITIN & DATA & ROUTE & ACL
    LABEL & PLACE & REGION & DATA & ROUTE --> FACADE
    ITIN --> ISVC
    ISVC --> FACADE
    ISVC --> IMAP
    ISVC --> SHARED
    ACL --> ACLREPO --> CLIENT
    ACL --> SHARED
    SHARED --> SLOCAL --> HDB
    SHARED --> ADAPTER
    SHARED --> ENGINE
    SHARED --> SCHED
    FACADE --> LOCAL --> LDB
    FACADE --> CLOUD --> CLIENT --> DB
    FACADE --> BACKEND --> HDB
    BACKEND --> SCHED --> ENGINE
    ENGINE --> SLOCAL
    ENGINE --> HDB
    ENGINE --> ADAPTER --> CLIENT
    HDB -. "status / liveQuery" .-> SCHED
    SCHED -. "state updates" .-> GATE
