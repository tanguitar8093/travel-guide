%% Domain relationships and storage scopes, 2026-10-20.
flowchart LR
    UI["UI / React"] --> CTRL["Controller"] --> LOGIC["Module services"]
    LOGIC --> FACADE["Typed database facade<br/>validation / local-cloud-hybrid"]
    FACADE --> LOCAL[("Standalone IndexedDB")]
    FACADE --> CLOUD[("Supabase personal records / owner RLS")]
    FACADE --> HYBRID[("Account/project IndexedDB / persistent outbox")]
    HYBRID --> SYNC["Engine / revisions / receipts / Web Lock"] --> CLOUD

    subgraph PERSONAL["Personal domain contracts"]
        REGION["Region<br/>id / name / zoom / googlePlaceId or legacy center"]
        PLACE["Place<br/>id / name / map reference<br/>regionIds / labelIds / private notes"]
        LABEL["Label<br/>id / name / color / parentId"]
        TRIP["Trip<br/>id / regionId / name / startDate / endDate"]
        ITEM["ItineraryItem<br/>tripId / placeId / date / order / note<br/>arrival / duration / transport / travelDuration / travelDistance"]
        RMAP["RouteMap<br/>optional tripId / selectedDate<br/>endpoint Google IDs / transport"]
        MARK["RouteMapPlace<br/>routeMapId / Google ID / optional name"]
        REGION -->|"many-to-many"| PLACE
        LABEL -. "parentId" .-> LABEL
        LABEL -->|"many-to-many"| PLACE
        REGION --> TRIP --> ITEM
        PLACE --> ITEM
        TRIP -->|"one linked map; delete cascades"| RMAP --> MARK
    end
    FACADE -. "personal records" .-> PERSONAL

    SHARED["Shared service / scoped RPC"]
    DOC[("Activated shared workspace<br/>trip + region projection<br/>scheduled public place fields + items")]
    ACL["Online membership / revisions / revocation"]
    LOGIC --> SHARED --> DOC
    SHARED --> ACL
    TRIP -. "explicit activation copies scheduled content once" .-> DOC
    DOC -. "owner cancellation keeps latest content" .-> TRIP
    DOC -. "hybrid cache / shared-task envelope" .-> HYBRID

    NOTES["Private place notes/labels are not shared<br/>Shared region/place view is not a collaborator private import<br/>Map coordinates/provider details resolved at runtime<br/>Personal JSON is not a shared/full DB backup"]
    PERSONAL -.-> NOTES
    DOC -.-> NOTES
