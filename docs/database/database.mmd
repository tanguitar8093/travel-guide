%% Persistence architecture, 2026-10-20. Full database backup is not personal JSON.
flowchart TB
    CLIENT["Feature services"]
    TYPES["Domain contracts<br/>Region / Place / Label / Trip / ItineraryItem / RouteMap / RouteMapPlace"]
    FACADE["database/index.ts typed facade<br/>local / cloud / hybrid"]
    VALID["Validation / explicit errors / referential integrity"]
    LOCAL["Injected IndexedDB repositories / transactions"]
    IDB[("TravelDatabase v7<br/>7 personal stores")]
    CLOUD["Supabase personal repositories"]
    DB[("Postgres / owner constraints / RLS / grants")]
    HYBRID["hybridBackend / LocalSyncStore<br/>atomic data and outbox"]
    HDB[("SyncDatabase v9 / project-user isolation<br/>personal stores / outbox / metadata / baselines / reviews / sharedItineraries")]
    ENGINE["Sync engine / account guard / Web Lock<br/>frozen operation receipts and revisions"]
    RPC["app_sync_snapshot / pull / push"]
    SHARED["SharedTripRepository / SharedTripLocal"]
    SHRPC["app_shared_trip / app_cancel_shared_trip"]
    ACL["TripCollaborationRepository / v2 RPC"]
    WORK[("One shared workspace per activated trip<br/>membership / deliveries / receipts / cancellation archive")]
    MIGRATIONS["Versioned migrations<br/>reconcile live catalog before approved incremental apply"]
    BACKUP["Personal JSON backup / preview-token overwrite<br/>not shared archive or incremental sync"]

    CLIENT --> FACADE
    TYPES -. "input / output" .-> FACADE
    FACADE --> VALID
    FACADE --> LOCAL --> IDB
    FACADE --> CLOUD --> DB
    FACADE --> HYBRID --> HDB
    HYBRID --> ENGINE --> RPC --> DB
    ENGINE --> HDB
    CLIENT --> SHARED
    SHARED --> HDB
    SHARED --> SHRPC --> WORK
    ENGINE --> SHRPC
    CLIENT --> ACL --> WORK
    WORK --> DB
    MIGRATIONS -.-> DB
    FACADE --> BACKUP
